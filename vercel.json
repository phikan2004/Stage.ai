{
  "services": {
    "client": {
      "root": "client/",
      "framework": "vite"
    },
    "server": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "buildCommand": "npm run typecheck"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
