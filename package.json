{
  "name": "producer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c auto \"npm -w server run dev\" \"npm -w client run dev\"",
    "test": "npm -w client run test",
    "build": "npm -w client run build && npm -w server run typecheck",
    "make-sample": "tsx scripts/make-sample.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "concurrently": "^10.0.5",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
