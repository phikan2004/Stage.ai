# Server-side only. Never exposed to the browser.
# Create a key at https://console.anthropic.com (API usage is billed separately from a Claude subscription).
ANTHROPIC_API_KEY=
# Which analysis the app runs: premium (default) or free. See shared/plans.ts.
# PRODUCER_PLAN=premium
# The next two override the plan. Leave them unset unless you're trying other settings.
# Any Claude model with image input. Opus 5.5 is the default; claude-sonnet-5-5 is cheaper and faster.
# VISION_MODEL=claude-opus-5-5
# Thinking effort for analysis: low | medium | high | xhigh | max
# VISION_EFFORT=high
# PORT=8787

# Optional: faster live speech recognition via Deepgram (https://console.deepgram.com → API Keys, "Member" role).
# Without it, the app uses Chrome's built-in speech recognition.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Where matters, decks and runs are stored (default: ./data)
# DATA_DIR=

# Supabase storage for matters, presentations and runs. Leave all three empty to store locally in ./data instead.
# Supabase dashboard → Connect. Replace [YOUR-PASSWORD] with your database password.
# Local: the Direct connection string (or Session pooler if your network is IPv4-only).
# Vercel: must be the Transaction pooler string (port 6543). Vercel can't reach the direct connection.
DATABASE_URL=
# Supabase dashboard → Project Settings → Data API → Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Supabase dashboard → Project Settings → API Keys → Secret key (sb_secret_…), or the legacy service_role key.
# Server-side only: it bypasses all access rules, so never put it in client code.
SUPABASE_SECRET_KEY=

# Stage runner (local only, `npm run stage`). Uses ANTHROPIC_API_KEY above.
# STAGE_MODEL=claude-opus-5-5
# Part of the audience display's name. Default: the first display that isn't the main one.
# STAGE_DISPLAY=DELL
# STAGE_PORT=8788
