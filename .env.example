# Server-side only. Never exposed to the browser.
# Create a key at https://console.anthropic.com (API usage is billed separately from a Claude subscription).
ANTHROPIC_API_KEY=
# Any Claude model with image input. Opus 5.5 is the default; claude-sonnet-5-5 is cheaper and faster.
VISION_MODEL=claude-opus-5-5
# Thinking effort for analysis: low | medium | high | xhigh | max
VISION_EFFORT=high
# PORT=8787

# Optional: faster live speech recognition via Deepgram (https://console.deepgram.com → API Keys, "Member" role).
# Without it, the app uses Chrome's built-in speech recognition.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
